{
	"name": "axiompress/axiompress",
	"version": "0.1.0-dev",
	"license": "GPL-2.0-or-later",
	"description": "AxiomPress is an independent, clean-break CMS fork of WordPress.",
	"homepage": "https://axiompress.dev",
	"keywords": [
		"blog", "cms", "wordpress", "wp"
	],
	"support": {
		"issues": "https://github.com/cbuntingde/wordpress-develop/issues"
	},
	"require": {
		"ext-hash": "*",
		"ext-json": "*",
		"php": ">=8.2"
	},
	"suggest": {
		"ext-apcu": "*",
		"ext-bc": "*",
		"ext-curl": "*",
		"ext-dom": "*",
		"ext-exif": "*",
		"ext-fileinfo": "*",
		"ext-filter": "*",
		"ext-ftp": "*",
		"ext-gd": "*",
		"ext-iconv": "*",
		"ext-igbinary": "*",
		"ext-imagick": "*",
		"ext-intl": "*",
		"ext-libxml": "*",
		"ext-mbstring": "*",
		"ext-memcached": "*",
		"ext-mysqli": "*",
		"ext-opcache": "*",
		"ext-openssl": "*",
		"ext-redis": "*",
		"ext-shmop": "*",
		"ext-simplexml": "*",
		"ext-sockets": "*",
		"ext-sodium": "*",
		"ext-ssh2": "*",
		"ext-timezonedb": "*",
		"ext-xml": "*",
		"ext-xmlreader": "*",
		"ext-zip": "*",
		"ext-zlib": "*"
	},
	"require-dev": {
		"composer/ca-bundle": "1.6.0",
		"squizlabs/php_codesniffer": "3.13.5",
		"wp-coding-standards/wpcs": "~3.4.1",
		"phpcompatibility/phpcompatibility-wp": "~2.1.3",
		"phpstan/phpstan": "2.3.2",
		"phpstan/phpstan-phpunit": "2.1.1",
		"yoast/phpunit-polyfills": "^1.1.0"
	},
	"config": {
		"audit": { "ignore": [ "GHSA-hmqg-cxww-wqhq", "PKSA-rdkp-vv9z-mjkg" ] },
		"policy": {
			"advisories": {
				"ignore-id": [ "GHSA-hmqg-cxww-wqhq", "PKSA-rdkp-vv9z-mjkg" ]
			}
		},
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		},
		"lock": false
	},
	"autoload-dev": {
		"psr-4": {
			"WordPress\\PHPStan\\": "tests/phpstan/"
		}
	},
	"scripts": {
		"lint:axiompress": "@php ./vendor/bin/phpcs --standard=phpcs-axiompress.xml.dist --report=summary",
		"test:protocol": "@php tests/axiompress/protocol-test.php",
		"test:broker": "@php tests/axiompress/broker-test.php",
		"phpstan": "@php ./vendor/bin/phpstan analyse --memory-limit=2G",
		"phpstan:baselines": [ "Composer\\Config::disableProcessTimeout", "@php ./tests/phpstan/generate-baselines.php" ],
		"compat": "@php ./vendor/squizlabs/php_codesniffer/bin/phpcs --standard=phpcompat.xml.dist --report=summary,source",
		"format": "@php ./vendor/squizlabs/php_codesniffer/bin/phpcbf --report=summary,source",
		"lint": "@php ./vendor/squizlabs/php_codesniffer/bin/phpcs --report=summary,source",
		"lint:errors": "@lint -n",
		"test": [ "Composer\\Config::disableProcessTimeout", "@php ./vendor/phpunit/phpunit/phpunit" ]
	}
}
